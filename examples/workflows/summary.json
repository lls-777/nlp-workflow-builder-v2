{
  "id": "acceptance_summary",
  "version": 1,
  "goal": "Generate a concise summary and five key points from uploaded files",
  "source_policy": "uploaded_files_only",
  "workflow_inputs": [
    {
      "name": "source_files",
      "value_type": "files",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "read_summary_files",
      "step_type": "read_document",
      "inputs": [
        {
          "name": "files",
          "bindings": [
            {
              "source": "workflow_input",
              "input_name": "source_files"
            }
          ]
        }
      ],
      "params": {},
      "title": "Read the uploaded files"
    },
    {
      "id": "generate_summary",
      "step_type": "generate_text",
      "inputs": [
        {
          "name": "materials",
          "bindings": [
            {
              "source": "step_output",
              "step_id": "read_summary_files",
              "output_name": "documents"
            }
          ]
        }
      ],
      "params": {
        "task": "summary",
        "bullet_count": 5,
        "max_length": 100
      },
      "title": "Generate a concise summary"
    }
  ],
  "result_bindings": [
    {
      "step_id": "generate_summary",
      "output_name": "text",
      "label": "Summary and key points",
      "display_type": "text"
    }
  ]
}
